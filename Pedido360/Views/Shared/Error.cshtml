@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="form-card p-5 text-center" style="max-width: 620px; margin: 3rem auto;">
    <div class="page-eyebrow mb-2" style="color: var(--brick);">Error inesperado</div>
    <h1 class="h3 mb-2">Ocurrio un problema procesando la solicitud</h1>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted small">Id de referencia: <code>@Model.RequestId</code></p>
    }

    <a class="btn btn-primary mt-2" asp-controller="Home" asp-action="Index">Ir al panel</a>
</div>
