@{
    ViewData["Title"] = "Pagina no encontrada";
    Layout = "_Layout";
}

<div class="form-card p-5 text-center" style="max-width: 560px; margin: 3rem auto;">
    <div class="page-eyebrow mb-2">Error 404</div>
    <h1 class="h3 mb-2">Esta pagina no existe</h1>
    <p class="text-muted">La ruta que buscas no esta en Pedidos360, o fue movida. Revisa el enlace o volve al panel.</p>
    <a class="btn btn-primary mt-2" asp-controller="Home" asp-action="Index">Ir al panel</a>
</div>
