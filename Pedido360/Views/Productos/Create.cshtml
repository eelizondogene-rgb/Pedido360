@model Pedido360.Models.Producto
@{
    ViewData["Title"] = "Nuevo producto";
}

<div class="page-header">
    <div class="page-eyebrow">Pedidos360 / Productos</div>
    <h1 class="h3 mb-1">Nuevo producto</h1>
</div>

<div class="form-card p-4">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="CategoriaId" class="form-label">Categoria</label>
                <select asp-for="CategoriaId" class="form-select" asp-items="ViewBag.Categorias">
                    <option value="">Seleccione una categoria</option>
                </select>
                <span asp-validation-for="CategoriaId" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Precio" class="form-label"></label>
                <input asp-for="Precio" class="form-control" />
                <span asp-validation-for="Precio" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="ImpuestoPorc" class="form-label">Impuesto %</label>
                <input asp-for="ImpuestoPorc" class="form-control" />
                <span asp-validation-for="ImpuestoPorc" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Stock" class="form-label"></label>
                <input asp-for="Stock" class="form-control" />
                <span asp-validation-for="Stock" class="text-danger"></span>
            </div>

            <div class="col-md-8">
                <label asp-for="ImagenUrl" class="form-label">URL de imagen <span style="color: var(--brick);">*</span></label>
                <input asp-for="ImagenUrl" class="form-control" required placeholder="https://..." />
                <span asp-validation-for="ImagenUrl" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <div class="form-check mt-4">
                    <input asp-for="Activo" class="form-check-input" />
                    <label asp-for="Activo" class="form-check-label"></label>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
