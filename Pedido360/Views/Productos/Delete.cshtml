@model Pedido360.Models.Producto
@{
    ViewData["Title"] = "Eliminar producto";
}

<div class="page-header">
    <div class="page-eyebrow">Pedidos360 / Productos</div>
    <h1 class="h3 mb-1" style="color: var(--brick);">Eliminar producto</h1>
</div>

<div class="form-card p-4">
    <p class="text-muted">Esta accion no se puede deshacer. Confirme que desea eliminar el siguiente producto:</p>

    <dl class="row">
        <dt class="col-sm-3">Nombre</dt>
        <dd class="col-sm-9">@Model.Nombre</dd>

        <dt class="col-sm-3">Precio</dt>
        <dd class="col-sm-9 num">₡@Model.Precio.ToString("N2")</dd>

        <dt class="col-sm-3">Stock</dt>
        <dd class="col-sm-9 num">@Model.Stock</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Confirmar eliminacion</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>
